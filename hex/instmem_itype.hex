// --- SETUP ---
01000093  // 1. ADDI x1, x0, 16   -> x1 = 16 (0x10)
// --- I-TYPE ALU TEST (Base: x1=16) ---
00A08113  // 2. ADDI  x2, x1, 10  -> 16 + 10 = 26
0140A193  // 3. SLTI  x3, x1, 20  -> (16 < 20)? Signed -> 1 (True)
00A0A213  // 4. SLTI  x4, x1, 10  -> (16 < 10)? Signed -> 0 (False)
0140B293  // 5. SLTIU x5, x1, 20  -> (16 < 20)? Unsigned -> 1
00F0C313  // 6. XORI  x6, x1, 15  -> 16 ^ 15 (10000 ^ 01111) = 11111 -> 31
0200E393  // 7. ORI   x7, x1, 32  -> 16 | 32 (010000 | 100000) -> 48
0070F413  // 8. ANDI  x8, x1, 7   -> 16 & 7  (10000 & 00111) -> 0
00209493  // 9.  SLLI x9, x1, 2   -> 16 << 2 = 64
0020D513  // 10. SRLI x10, x1, 2  -> 16 >> 2 = 4
4020D593  // 11. SRAI x11, x1, 2  -> 16 >>> 2 = 4 (Arithmetic)
FFA08613  // 12. ADDI x12, x1, -6 -> 16 + (-6) = 10
00000013  // NOP
00000013  // NOP
00000013  // NOP

