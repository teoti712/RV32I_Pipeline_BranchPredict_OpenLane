// PC = 0x08. Nếu JAL không nhảy, nó sẽ chạy vào đây.
00000113  // 3. ADDI x2, x0, 0     (FAIL MARKER)

// --- TARGET JAL (PASS ZONE) ---
// PC = 0x0C.
00100113  // 4. ADDI x2, x0, 1     (PASS MARKER cho JAL)

