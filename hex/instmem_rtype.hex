// --- SETUP PHASE (I-TYPE) ---
0F000093  // 1. ADDI x1, x0, 240  -> x1 = 240 (0x000000F0)
00400113  // 2. ADDI x2, x0, 4    -> x2 = 4   (0x00000004)
// --- R-TYPE EXECUTION PHASE ---
002081B3  // 3. ADD  x3, x1, x2   -> 240 + 4 = 244
40208233  // 4. SUB  x4, x1, x2   -> 240 - 4 = 236
002092B3  // 5. SLL  x5, x1, x2   -> 240 << 4 = 3840 (0xF00)
0020A333  // 6. SLT  x6, x1, x2   -> (240 < 4)? Signed -> 0
0020B3B3  // 7. SLTU x7, x1, x2   -> (240 < 4)? Unsigned -> 0
0020C433  // 8. XOR  x8, x1, x2   -> 240 ^ 4 = 244 (0xF4)
0020D4B3  // 9. SRL  x9, x1, x2   -> 240 >> 4 = 15 (0x0F)
4020D533  // 10. SRA x10, x1, x2  -> 240 >>> 4 = 15 (Arithmetic shift)
0020E5B3  // 11. OR  x11, x1, x2  -> 240 | 4 = 244 (0xF4)
0020F633  // 12. AND x12, x1, x2  -> 240 & 4 = 0
00000013  // 13. NOP
00000013  // 14. NOP
00000013  // 15. NOP

